<%= content_for :page_title, t("admin.bulk_invitations.new.title") %>

<div class="bg-container rounded-xl shadow-border-xs p-6 max-w-2xl">
  <div class="mb-6">
    <h1 class="text-xl font-semibold text-primary mb-1"><%= t("admin.bulk_invitations.new.title") %></h1>
    <p class="text-sm text-secondary"><%= t("admin.bulk_invitations.new.description") %></p>
  </div>

  <div class="mb-8 space-y-2">
    <h2 class="text-sm font-semibold text-primary mb-3"><%= t(".heading", count: @results.size) %></h2>
    <% @results.each do |result| %>
      <div class="flex items-start gap-3 px-4 py-3 rounded-lg border <%= result[:status] == :error ? 'border-red-200 bg-red-50' : 'border-primary bg-container-inset' %>">
        <% if result[:status] == :reserved %>
          <%= icon "user-plus", class: "w-4 h-4 text-secondary mt-0.5 shrink-0" %>
          <div class="flex-1 flex items-start justify-between gap-3">
            <div>
              <p class="text-sm font-medium text-primary"><%= result[:email] %></p>
              <p class="text-xs text-secondary"><%= t(".reserved") %></p>
            </div>
            <%= link_to t(".revoke"), admin_invitation_path(result[:invitation_id]),
                  method: :delete, data: { confirm: t(".revoke_confirm") },
                  class: "text-xs text-red-600 hover:text-red-800 border border-red-300 rounded-lg px-2 py-1 hover:bg-red-50 transition-colors shrink-0" %>
          </div>
        <% elsif result[:status] == :existing %>
          <%= icon "user", class: "w-4 h-4 text-secondary mt-0.5 shrink-0" %>
          <div>
            <p class="text-sm font-medium text-primary"><%= result[:email] %></p>
            <p class="text-xs text-secondary"><%= t(".existing") %></p>
          </div>
        <% elsif result[:status] == :moved %>
          <%= icon "user-check", class: "w-4 h-4 text-green-600 mt-0.5 shrink-0" %>
          <div>
            <p class="text-sm font-medium text-primary"><%= result[:email] %></p>
            <p class="text-xs text-secondary"><%= t(".moved") %></p>
          </div>
        <% else %>
          <%= icon "circle-x", class: "w-4 h-4 text-red-500 mt-0.5 shrink-0" %>
          <div>
            <p class="text-sm font-medium text-primary"><%= result[:email] %></p>
            <p class="text-xs text-red-500"><%= result[:errors].join(", ") %></p>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <%= link_to t(".invite_more"), new_admin_bulk_invitations_path, class: "text-sm text-secondary hover:text-primary" %>
</div>
