    <div class="prose prose-sm sm:prose max-w-none text-primary space-y-8">

      <div class="text-sm text-subdued space-y-1">
        <p><strong class="font-medium text-primary">Effective Date:</strong> 01.06.2026</p>
        <p><strong class="font-medium text-primary">Last Updated:</strong> 19.05.2026</p>
