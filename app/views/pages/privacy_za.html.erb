      Address: 676 Gallagher Avenue, Halfway House, Midrand<br>
      Email: <a href="mailto:companion@chancen.international">companion@chancen.international</a><br>
      Phone: <a href="tel:+27101584405">+27 10 158 4405</a>
    </address>
  </section>
  </div>
