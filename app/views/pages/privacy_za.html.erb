<%# South Africa Privacy Policy — styled to echo the supplied Chancen document. %>
<style>
  .privacy-policy {
    --privacy-teal: #155766;
    --privacy-green: #07543f;
    --privacy-orange: #ff8515;
    box-sizing: border-box;
    max-width: 850px;
    margin: 32px auto;
    padding: 0 0 56px;
    background: #fff;
    color: #171717;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 16px;
    line-height: 1.48;
  }
  .privacy-policy *, .privacy-policy *::before, .privacy-policy *::after { box-sizing: border-box; }
  .privacy-policy__masthead {
    min-height: 82px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 58px;
    border-bottom: 1px solid #ececec;
  }
  .privacy-policy__accent { width: 82px; height: 68px; background: var(--privacy-orange); }
  .privacy-policy__brand { padding: 12px 8px 0 16px; color: var(--privacy-green); text-align: right; }
  .privacy-policy__brand-name { display: block; font-size: 17px; line-height: 1.1; letter-spacing: .04em; font-weight: 700; }
  .privacy-policy__brand-subtitle { display: block; margin-top: 3px; font-size: 11px; letter-spacing: .09em; }
  .privacy-policy__brand-tagline { display: block; margin-top: 7px; font-size: 8px; letter-spacing: .12em; }
  .privacy-policy__cover { padding: 0 28px 42px; border-bottom: 1px solid #e7e7e7; margin-bottom: 34px; }
  .privacy-policy h1 { margin: 0 0 34px; color: var(--privacy-teal); font-size: 27px; line-height: 1.2; font-weight: 700; text-transform: uppercase; }
  .privacy-policy__eyebrow { margin: 0 0 14px; font-size: 16px; font-weight: 700; }
  .privacy-policy__metadata { margin: 0; display: grid; grid-template-columns: max-content 1fr; column-gap: 8px; row-gap: 3px; font-size: 15px; }
  .privacy-policy__metadata dt { font-weight: 700; }
  .privacy-policy__metadata dd { margin: 0; }
  .privacy-policy__body { padding: 0 28px; }
  .privacy-policy__document-meta { margin-bottom: 24px; }
  .privacy-policy__document-meta p { margin: 0 0 4px; }
  .privacy-policy p { margin: 0 0 14px; }
  .privacy-policy section { margin: 0 0 30px; }
  .privacy-policy h2 { margin: 30px 0 14px; color: #111; font-size: 22px; line-height: 1.25; font-weight: 700; }
  .privacy-policy h3 { margin: 20px 0 8px; font-size: 16px; line-height: 1.3; font-weight: 700; }
  .privacy-policy ul { margin: 0 0 16px; padding-left: 24px; }
  .privacy-policy li { padding-left: 2px; margin: 0 0 5px; }
  .privacy-policy address { margin: 18px 0 22px; font-style: normal; line-height: 1.9; }
  .privacy-policy a { color: var(--privacy-teal); text-decoration: underline; overflow-wrap: anywhere; }
  .privacy-policy__section-rule { border: 0; border-top: 1px solid #ededed; margin: 26px 0; }
  @media (max-width: 640px) {
    .privacy-policy { margin: 0 auto; padding-bottom: 32px; font-size: 15px; }
    .privacy-policy__masthead { margin-bottom: 34px; }
    .privacy-policy__cover, .privacy-policy__body { padding-left: 20px; padding-right: 20px; }
    .privacy-policy h1 { font-size: 23px; }
    .privacy-policy h2 { font-size: 20px; }
    .privacy-policy__metadata { grid-template-columns: 1fr; row-gap: 0; }
    .privacy-policy__metadata dd { margin: 0 0 8px; }
  }
  @media print {
    .privacy-policy { max-width: none; margin: 0; padding: 0; font-size: 11pt; }
    .privacy-policy__masthead { break-after: avoid; }
    .privacy-policy section { break-inside: avoid-page; }
    .privacy-policy a { color: inherit; }
  }
</style>

<article class="privacy-policy privacy-policy--south-africa">
