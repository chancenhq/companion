  <div class="bg-container border border-primary rounded-xl p-6 sm:p-10 shadow-sm">
    <h1 class="text-2xl sm:text-3xl font-bold text-primary mb-4"><%= t(".heading", document: document, country: @country.name) %></h1>
    <p class="text-subdued mb-3"><%= t(".body", document: document.downcase, country: @country.name) %></p>
