<%= render "layouts/shared/htmldoc" do %>
  <%# htmldoc locks html/body to the viewport height with overflow hidden, so
      this wrapper has to be the scroll container (as in the auth layout). %>
  <div class="h-full overflow-y-auto bg-surface text-primary font-medium flex flex-col">
    <div class="flex-1">
      <%= yield %>
    </div>

    <% if content_for?(:footer) %>
      <%= yield :footer %>
    <% else %>
      <%= render "layouts/shared/footer" %>
    <% end %>
  </div>
<% end %>
